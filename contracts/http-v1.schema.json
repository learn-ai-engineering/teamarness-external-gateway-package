{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Gateway HTTP v1",
  "$defs": {
    "call": {
      "type": "object",
      "required": [
        "contract",
        "major",
        "port",
        "request"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "maxLength": 128
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "port": {
          "type": "string",
          "maxLength": 128
        },
        "request": {}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "source",
            "code",
            "retryable",
            "outcomeUncertain",
            "details"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "gateway",
                "host",
                "provider"
              ]
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]{1,128}$"
            },
            "retryable": {
              "type": "boolean"
            },
            "outcomeUncertain": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {}
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": [
        "version",
        "readOnly",
        "workspace",
        "routes",
        "limits",
        "supportedShapes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "readOnly": {
          "const": false
        },
        "workspace": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "routes": {
          "type": "object",
          "required": [
            "contracts",
            "onboarding",
            "call",
            "subscribe"
          ],
          "properties": {
            "contracts": {
              "const": "/v1/contracts"
            },
            "onboarding": {
              "const": "/v1/onboarding"
            },
            "call": {
              "const": "/v1/call"
            },
            "subscribe": {
              "const": "/v1/subscribe"
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": [
            "outstandingSdkInvocations",
            "portValueBytes",
            "metadataBytes",
            "toolWaitSeconds",
            "streams",
            "streamHeartbeatSeconds",
            "streamWriteSeconds",
            "streamFrameAllowanceBytes"
          ],
          "properties": {
            "outstandingSdkInvocations": {
              "const": 12
            },
            "portValueBytes": {
              "const": 262144
            },
            "metadataBytes": {
              "const": 1048576
            },
            "toolWaitSeconds": {
              "const": 25
            },
            "streams": {
              "const": 8
            },
            "streamHeartbeatSeconds": {
              "const": 15
            },
            "streamWriteSeconds": {
              "const": 5
            },
            "streamFrameAllowanceBytes": {
              "const": 4096
            }
          },
          "additionalProperties": false
        },
        "supportedShapes": {
          "const": [
            {
              "kind": "query",
              "delivery": "response"
            },
            {
              "kind": "command",
              "delivery": "response"
            },
            {
              "kind": "query",
              "delivery": "stream"
            },
            {
              "kind": "event",
              "delivery": "stream"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "onboarding": {
      "type": "object",
      "required": [
        "markdown"
      ],
      "properties": {
        "markdown": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "required": [
        "contracts",
        "nextCursor"
      ],
      "properties": {
        "contracts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "contract",
              "major",
              "minor"
            ],
            "properties": {
              "contract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "major": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "minor": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 2731,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "schema": {
      "type": "object",
      "required": [
        "contract",
        "major",
        "minor",
        "metadataSha256",
        "projectionSha256",
        "schema"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "metadataSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projectionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "guide": {
      "type": "object",
      "required": [
        "contract",
        "major",
        "minor",
        "markdown",
        "preface",
        "guideSha256"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "markdown": {
          "type": "string"
        },
        "preface": {
          "type": "string"
        },
        "guideSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "subscribe": {
      "type": "object",
      "required": [
        "contract",
        "major",
        "port",
        "request"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "maxLength": 128
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "port": {
          "type": "string",
          "maxLength": 128
        },
        "request": {}
      },
      "additionalProperties": false
    },
    "ready": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ready"
        },
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "port": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "query",
            "event"
          ]
        },
        "delivery": {
          "const": "stream"
        }
      },
      "required": [
        "type",
        "contract",
        "major",
        "port",
        "kind",
        "delivery"
      ],
      "additionalProperties": false
    },
    "value": {
      "type": "object",
      "properties": {
        "type": {
          "const": "value"
        },
        "value": {}
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "heartbeat": {
      "type": "object",
      "properties": {
        "type": {
          "const": "heartbeat"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "endCompleted": {
      "type": "object",
      "properties": {
        "type": {
          "const": "end"
        },
        "reason": {
          "const": "completed"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false
    },
    "endError": {
      "type": "object",
      "properties": {
        "type": {
          "const": "end"
        },
        "reason": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "required": [
            "source",
            "code",
            "retryable",
            "outcomeUncertain",
            "details"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "gateway",
                "host",
                "provider"
              ]
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]{1,128}$"
            },
            "retryable": {
              "type": "boolean"
            },
            "outcomeUncertain": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        }
      },
      "required": [
        "type",
        "reason",
        "error"
      ],
      "additionalProperties": false
    },
    "streamFrame": {
      "anyOf": [
        {
          "$ref": "#/$defs/ready"
        },
        {
          "$ref": "#/$defs/value"
        },
        {
          "$ref": "#/$defs/heartbeat"
        },
        {
          "$ref": "#/$defs/endCompleted"
        },
        {
          "$ref": "#/$defs/endError"
        }
      ]
    }
  },
  "x-limits": {
    "MAX_CONNECTIONS": 32,
    "MAX_HEADER_BYTES": 16384,
    "MAX_HEADERS": 64,
    "MAX_TARGET_BYTES": 4096,
    "REQUEST_READ_TIMEOUT": 5,
    "RESPONSE_WRITE_TIMEOUT": 5,
    "REQUESTS_PER_SECOND": 8,
    "REQUEST_BURST": 16,
    "MAX_HOST_CALLS": 12,
    "TOOL_WAIT_TIMEOUT": 25,
    "PORT_VALUE_BYTES": 262144,
    "ENVELOPE_ALLOWANCE_BYTES": 4096,
    "METADATA_BYTES": 1048576,
    "METADATA_CHUNK_BYTES": 65536,
    "SUMMARY_ROWS": 32,
    "SUMMARY_BYTES": 32768,
    "METADATA_CACHE_BYTES": 16777216,
    "MAX_CATALOG_RESTARTS": 1,
    "CATALOG_POLL_INTERVAL": 5,
    "CATALOG_READ_TIMEOUT": 5,
    "LISTENER_DRAIN_TIMEOUT": 5,
    "MAX_HOST_CURSOR_BYTES": 2048,
    "MAX_HTTP_CURSOR_CHARS": 2731,
    "MAX_STREAMS": 8,
    "STREAM_HEARTBEAT_SECONDS": 15,
    "STREAM_WRITE_SECONDS": 5,
    "STREAM_FRAME_ALLOWANCE_BYTES": 4096
  },
  "x-gateway-status": {
    "unauthorized": 401,
    "bad_request": 400,
    "forbidden": 403,
    "not_found": 404,
    "method_not_allowed": 405,
    "unsupported_media_type": 415,
    "too_large": 413,
    "rate_limited": 429,
    "busy": 503,
    "timeout": 504,
    "catalog_changed": 409,
    "unavailable": 503,
    "storage_failed": 503
  }
}
