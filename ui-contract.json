{
  "schemaVersion": 1,
  "$defs": {
    "Token": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 22
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "managed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "generation"
      ],
      "additionalProperties": false
    },
    "ObservedContract": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "contract",
        "major"
      ],
      "additionalProperties": false
    },
    "Status": {
      "type": "object",
      "properties": {
        "desiredEnabled": {
          "type": "boolean"
        },
        "port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "running": {
          "type": "boolean"
        },
        "storageFailed": {
          "type": "boolean"
        },
        "warning": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Token"
          },
          "maxItems": 32
        },
        "selectedContracts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "selectedTools": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      },
      "required": [
        "desiredEnabled",
        "port",
        "running",
        "storageFailed",
        "warning",
        "tokens",
        "selectedContracts",
        "selectedTools"
      ],
      "additionalProperties": false
    },
    "Contract": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "available": {
          "type": "boolean"
        },
        "hostEnabled": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "guideEligibility": {
          "enum": [
            "eligible",
            "missing",
            "unavailable"
          ]
        }
      },
      "required": [
        "contract",
        "major",
        "provider",
        "displayName",
        "available",
        "hostEnabled",
        "selected",
        "guideEligibility"
      ],
      "additionalProperties": false
    },
    "Tool": {
      "type": "object",
      "properties": {
        "port": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "eligible": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "reviewRequired": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "query",
            "command",
            "event"
          ]
        },
        "delivery": {
          "enum": [
            "response",
            "stream"
          ]
        }
      },
      "required": [
        "port",
        "fingerprint",
        "eligible",
        "selected",
        "reviewRequired",
        "kind",
        "delivery"
      ],
      "additionalProperties": false
    },
    "SetupStatus": {
      "type": "object",
      "properties": {
        "operationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "intent": {
          "anyOf": [
            {
              "enum": [
                "connect",
                "repair",
                "rotate",
                "disconnect",
                "install-skill"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "enum": [
            "idle",
            "accepted",
            "prepared",
            "outputs",
            "committed",
            "complete",
            "repair-required",
            "conflict",
            "cleanup-pending"
          ]
        },
        "command": {
          "enum": [
            "unchanged",
            "pending",
            "installed"
          ]
        },
        "skill": {
          "enum": [
            "not-requested",
            "pending",
            "installed"
          ]
        },
        "access": {
          "enum": [
            "unchanged",
            "pending",
            "configured",
            "revoked",
            "repair-required"
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "commandPath": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "skillPath": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operationId",
        "intent",
        "phase",
        "command",
        "skill",
        "access",
        "error",
        "commandPath",
        "skillPath"
      ],
      "additionalProperties": false
    },
    "CommandVersion": {
      "type": "object",
      "properties": {
        "installation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "installation",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "CommandChange": {
      "type": "object",
      "properties": {
        "disposition": {
          "enum": [
            "install",
            "unchanged",
            "refresh",
            "explicit-repair"
          ]
        },
        "installed": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandVersion"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed": {
          "$ref": "#/$defs/CommandVersion"
        }
      },
      "required": [
        "disposition",
        "installed",
        "proposed"
      ],
      "additionalProperties": false
    }
  },
  "requests": {
    "external-gateway.status.get": {
      "request": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "response": {
        "$ref": "#/$defs/Status"
      }
    },
    "external-gateway.catalog.page": {
      "request": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Contract"
            },
            "maxItems": 32
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Tool"
            },
            "maxItems": 32
          },
          "nextOffset": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "contracts",
          "nextCursor",
          "tools",
          "nextOffset"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.listener.set": {
      "request": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ok",
          "warning"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.port.set": {
      "request": {
        "type": "object",
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required": [
          "port"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ok",
          "warning"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.package.set": {
      "request": {
        "type": "object",
        "properties": {
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ObservedContract"
            },
            "maxItems": 256
          }
        },
        "required": [
          "provider",
          "enabled",
          "contracts"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ok",
          "warning"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.tool.set": {
      "request": {
        "type": "object",
        "properties": {
          "contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "major": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "port": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "contract",
          "major",
          "provider",
          "port",
          "fingerprint",
          "enabled"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ok",
          "warning"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.token.create": {
      "request": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 22
          },
          "bearer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70
          }
        },
        "required": [
          "id",
          "bearer"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.token.regenerate": {
      "request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 22
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 22
          },
          "bearer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70
          }
        },
        "required": [
          "id",
          "bearer"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.token.revoke": {
      "request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 22
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ok",
          "warning"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.disable-and-revoke-all": {
      "request": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ok",
          "warning"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.setup.preview": {
      "request": {
        "type": "object",
        "properties": {
          "intent": {
            "enum": [
              "connect",
              "repair",
              "rotate",
              "disconnect",
              "install-skill"
            ]
          },
          "selectionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "intent"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "intent": {
            "enum": [
              "connect",
              "repair",
              "rotate",
              "disconnect",
              "install-skill"
            ]
          },
          "commandPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "skillPath": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "credentialChange": {
            "type": "boolean"
          },
          "commandChange": {
            "anyOf": [
              {
                "$ref": "#/$defs/CommandChange"
              },
              {
                "type": "null"
              }
            ]
          },
          "skillChange": {
            "enum": [
              "not-requested",
              "publish",
              "unchanged"
            ]
          }
        },
        "required": [
          "planId",
          "intent",
          "commandPath",
          "skillPath",
          "credentialChange",
          "commandChange",
          "skillChange"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.setup.apply": {
      "request": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "planId"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "operationId"
        ],
        "additionalProperties": false
      }
    },
    "external-gateway.setup.status": {
      "request": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "response": {
        "$ref": "#/$defs/SetupStatus"
      }
    }
  },
  "subscriptions": {
    "external-gateway.status.watch": {
      "request": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "event": {
        "$ref": "#/$defs/Status"
      }
    },
    "external-gateway.setup.watch": {
      "request": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "event": {
        "$ref": "#/$defs/SetupStatus"
      }
    },
    "external-gateway.setup.choose-skill-folder": {
      "request": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "event": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "outcome": {
                "const": "selected"
              },
              "selectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "outcome",
              "selectionId",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "outcome": {
                "const": "cancelled"
              }
            },
            "required": [
              "outcome"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
